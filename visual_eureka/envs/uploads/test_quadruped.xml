<mujoco model="test_quadruped">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" cone="elliptic" impratio="100"/>

  <default>
    <default class="quadruped">
      <geom friction="0.8 0.02 0.01" condim="3" margin="0.001"/>
      <joint damping="2.0" armature="0.01" frictionloss="0.2"/>
      <motor ctrlrange="-25 25"/>
      <default class="abd_joint">
        <joint axis="1 0 0" range="-0.8 0.8"/>
      </default>
      <default class="hip_joint">
        <joint axis="0 1 0" range="-1.5 3.5"/>
      </default>
      <default class="knee_joint">
        <joint axis="0 1 0" range="-2.7 -0.5"/>
        <motor ctrlrange="-45 45"/>
      </default>
      <default class="body_geom">
        <geom rgba="0.3 0.3 0.35 1"/>
      </default>
      <default class="leg_geom">
        <geom rgba="0.45 0.45 0.5 1"/>
      </default>
      <default class="foot_geom">
        <geom rgba="0.2 0.2 0.25 1" size="0.02" condim="6"
              solimp="0.015 1 0.02" priority="1"
              friction="0.8 0.02 0.01"/>
      </default>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.15 0.1" rgb2="0.15 0.2 0.15" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="grid_mat" conaffinity="1" condim="6"/>

    <body name="base" pos="0 0 0.35" childclass="quadruped">
      <inertial pos="0 0 0" mass="7.0" diaginertia="0.05 0.12 0.1"/>
      <freejoint name="root"/>
      <geom name="torso" type="box" size="0.15 0.06 0.04" class="body_geom"/>
      <site name="imu" pos="0 0 0.04"/>

      <!-- Front Left Leg -->
      <body name="FL_hip" pos="0.15 0.06 0">
        <inertial pos="0 0.02 0" mass="0.5" diaginertia="0.001 0.001 0.0005"/>
        <joint name="FL_hip_joint" class="abd_joint"/>
        <geom name="FL_hip_geom" type="sphere" size="0.025" class="leg_geom"/>
        <body name="FL_thigh" pos="0 0.04 0">
          <inertial pos="0 0 -0.1" mass="0.8" diaginertia="0.003 0.003 0.0005"/>
          <joint name="FL_thigh_joint" class="hip_joint"/>
          <geom name="FL_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.018" class="leg_geom"/>
          <body name="FL_calf" pos="0 0 -0.2">
            <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.001 0.001 0.0002"/>
            <joint name="FL_calf_joint" class="knee_joint"/>
            <geom name="FL_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.015" class="leg_geom"/>
            <geom name="FL_foot" type="sphere" pos="0 0 -0.2" class="foot_geom"/>
          </body>
        </body>
      </body>

      <!-- Front Right Leg -->
      <body name="FR_hip" pos="0.15 -0.06 0">
        <inertial pos="0 -0.02 0" mass="0.5" diaginertia="0.001 0.001 0.0005"/>
        <joint name="FR_hip_joint" class="abd_joint"/>
        <geom name="FR_hip_geom" type="sphere" size="0.025" class="leg_geom"/>
        <body name="FR_thigh" pos="0 -0.04 0">
          <inertial pos="0 0 -0.1" mass="0.8" diaginertia="0.003 0.003 0.0005"/>
          <joint name="FR_thigh_joint" class="hip_joint"/>
          <geom name="FR_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.018" class="leg_geom"/>
          <body name="FR_calf" pos="0 0 -0.2">
            <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.001 0.001 0.0002"/>
            <joint name="FR_calf_joint" class="knee_joint"/>
            <geom name="FR_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.015" class="leg_geom"/>
            <geom name="FR_foot" type="sphere" pos="0 0 -0.2" class="foot_geom"/>
          </body>
        </body>
      </body>

      <!-- Rear Left Leg -->
      <body name="RL_hip" pos="-0.15 0.06 0">
        <inertial pos="0 0.02 0" mass="0.5" diaginertia="0.001 0.001 0.0005"/>
        <joint name="RL_hip_joint" class="abd_joint"/>
        <geom name="RL_hip_geom" type="sphere" size="0.025" class="leg_geom"/>
        <body name="RL_thigh" pos="0 0.04 0">
          <inertial pos="0 0 -0.1" mass="0.8" diaginertia="0.003 0.003 0.0005"/>
          <joint name="RL_thigh_joint" class="hip_joint"/>
          <geom name="RL_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.018" class="leg_geom"/>
          <body name="RL_calf" pos="0 0 -0.2">
            <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.001 0.001 0.0002"/>
            <joint name="RL_calf_joint" class="knee_joint"/>
            <geom name="RL_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.015" class="leg_geom"/>
            <geom name="RL_foot" type="sphere" pos="0 0 -0.2" class="foot_geom"/>
          </body>
        </body>
      </body>

      <!-- Rear Right Leg -->
      <body name="RR_hip" pos="-0.15 -0.06 0">
        <inertial pos="0 -0.02 0" mass="0.5" diaginertia="0.001 0.001 0.0005"/>
        <joint name="RR_hip_joint" class="abd_joint"/>
        <geom name="RR_hip_geom" type="sphere" size="0.025" class="leg_geom"/>
        <body name="RR_thigh" pos="0 -0.04 0">
          <inertial pos="0 0 -0.1" mass="0.8" diaginertia="0.003 0.003 0.0005"/>
          <joint name="RR_thigh_joint" class="hip_joint"/>
          <geom name="RR_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.018" class="leg_geom"/>
          <body name="RR_calf" pos="0 0 -0.2">
            <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.001 0.001 0.0002"/>
            <joint name="RR_calf_joint" class="knee_joint"/>
            <geom name="RR_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.015" class="leg_geom"/>
            <geom name="RR_foot" type="sphere" pos="0 0 -0.2" class="foot_geom"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="FL_hip" joint="FL_hip_joint" class="quadruped"/>
    <motor name="FL_thigh" joint="FL_thigh_joint" class="quadruped"/>
    <motor name="FL_calf" joint="FL_calf_joint" class="knee_joint"/>
    <motor name="FR_hip" joint="FR_hip_joint" class="quadruped"/>
    <motor name="FR_thigh" joint="FR_thigh_joint" class="quadruped"/>
    <motor name="FR_calf" joint="FR_calf_joint" class="knee_joint"/>
    <motor name="RL_hip" joint="RL_hip_joint" class="quadruped"/>
    <motor name="RL_thigh" joint="RL_thigh_joint" class="quadruped"/>
    <motor name="RL_calf" joint="RL_calf_joint" class="knee_joint"/>
    <motor name="RR_hip" joint="RR_hip_joint" class="quadruped"/>
    <motor name="RR_thigh" joint="RR_thigh_joint" class="quadruped"/>
    <motor name="RR_calf" joint="RR_calf_joint" class="knee_joint"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0.35 1 0 0 0 0 0.6 -1.2 0 0.6 -1.2 0 0.6 -1.2 0 0.6 -1.2"/>
  </keyframe>
</mujoco>
